# --- Wajib untuk Masuk & Daftar (Supabase Auth) ---
# Dipakai di browser untuk login, daftar, verifikasi kode OTP email, dan
# baca/tulis tabel profil (mitra_profiles/industri_profiles) — semuanya
# lewat sesi yang didapat dari verifikasi OTP, jadi cukup pakai anon key,
# tidak perlu service role key lagi. Ambil dari Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Opsional: dipakai lib/supabase.ts di server untuk baca data
# leaderboard (lihat bagian bawah) kalau kamu pilih Supabase sebagai
# sumber datanya. TIDAK dipakai untuk alur Masuk/Daftar.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sumber data leaderboard (opsional) ---
# Isi salah satu saja sesuai backend yang dipakai. Urutan prioritas:
# Redis (Upstash) > Redis (TCP) > Supabase (di atas) > REST API custom > data dummy.
# Kalau semuanya kosong, leaderboard otomatis pakai data dummy di
# lib/leaderboard-data.ts — halaman tetap jalan normal.

# --- Opsi 1: Redis via Upstash (REST) ---
# Cocok untuk deploy serverless/edge (mis. Vercel Edge Runtime).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Opsi 2: Redis via koneksi TCP langsung (ioredis) ---
# Cocok untuk Redis self-hosted, Redis Cloud, AWS ElastiCache, dll.
# Format: redis://default:password@host:6379 (pakai rediss:// kalau TLS)
REDIS_URL=

# --- Opsi 3: REST API custom ---
# Harus mengembalikan JSON array yang match dengan interface LeaderboardEntry
# di lib/leaderboard-data.ts
LEADERBOARD_API_URL=

